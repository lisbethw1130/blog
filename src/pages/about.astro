---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: '關於我 - Lisbeth Wu',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="Lisbeth Wu"
    tagline="Backend/DevOps 工程師"
    actions={[{ variant: 'primary', text: '聯絡我', href: getPermalink('/contact') }]}
  >
    <Fragment slot="subtitle">
      我是一位專精於後端開發與 DevOps 的工程師，擁有豐富的 Ruby on Rails 和 AWS 雲端基礎設施經驗。<br />
      致力於建構高效能、可擴展的系統架構，並積極參與開源社群貢獻。
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'GitHub',
          href: 'https://github.com/lisbethw1130',
        },
      },
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'LinkedIn',
          href: 'https://www.linkedin.com/in/lisbethwu/',
        },
      },
      {
        icon: 'tabler:mail',
        callToAction: {
          text: 'Email',
          href: 'mailto:meow@liswu.me',
        },
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Lisbeth Wu',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">關於我</h2>
      <p>
        歡迎來到我的技術世界。我專注於後端系統開發與 DevOps 實踐，
        每一行程式碼都體現了我對於技術品質和系統效能的堅持。
      </p>
      <br />
      <p>
        我從日常的技術挑戰中獲得靈感，無論是優化系統效能、設計 CI/CD 管道，
        還是參與開源專案的協作開發。
      </p>
      <br />
      <p>
        除了技術工作，我也積極參與社群活動，相信知識分享能推動整個技術生態的進步。
      </p>
      <br />
      <p>如果您想要深入了解我的工作，歡迎透過以下方式聯絡我：</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="工作經驗"
    items={[
      {
        title:
          'DevOps 工程師 <br /> <span class="font-normal">Womany Media Group, 台北</span> <br /> <span class="text-sm font-normal">2019 - 現在</span>',
        description: `從零開始設計並實作分散式管道和雲端基礎設施，成功處理超過百萬流量。<br />
        主要負責：<br />
        • AWS 雲端架構設計與管理<br />
        • 容器化微服務架構轉換<br />
        • CI/CD 管道建置與優化<br />
        • 系統監控與自動化部署`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          '後端工程師 <br /> <span class="font-normal">前一份工作</span> <br /> <span class="text-sm font-normal">2017 - 2019</span>',
        description: `專精於 Ruby on Rails 和 PHP 後端開發，具備大型應用系統開發經驗。<br />
        • API 設計與開發<br />
        • 資料庫架構優化<br />
        • 系統效能調優<br />
        • 第三方服務整合`,
        icon: 'tabler:code',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="education"
    title="認證與成就"
    items={[
      {
        title: 'AWS Solutions Architect',
        description: '具備完整的 AWS 雲端架構設計能力，專精於 ECS、EC2 自動擴展等服務。',
        icon: 'tabler:certificate',
      },
      {
        title: 'AWS Developer Associate',
        description: '熟悉 AWS 開發工具與最佳實踐，能夠建構高效能的雲端應用程式。',
        icon: 'tabler:certificate',
      },
      {
        title: '開源社群貢獻',
        description: '積極參與開源專案，透過 GitHub 貢獻程式碼，分享技術知識與經驗。',
        icon: 'tabler:heart',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="核心技能"
    subtitle="我的技術專長涵蓋後端開發、DevOps 實踐以及雲端架構設計"
    columns={3}
    defaultIcon="tabler:point"
    items={[
      {
        title: 'Ruby on Rails',
        description: '具備豐富的 Rails 應用開發經驗，熟悉 MVC 架構和最佳實踐。',
        icon: 'tabler:code',
      },
      {
        title: 'AWS 雲端服務',
        description: '專精於 ECS、EC2、Lambda 等 AWS 服務，擁有 Solutions Architect 認證。',
        icon: 'tabler:cloud',
      },
      {
        title: 'Docker',
        description: '容器化技術專家，能夠設計高效的容器架構和編排。',
        icon: 'tabler:brand-docker',
      },
      {
        title: 'DevOps 工具鏈',
        description: '熟練使用 CI/CD 工具，建構自動化部署管道。',
        icon: 'tabler:tools',
      },
      {
        title: 'PHP',
        description: '具備 PHP 開發經驗，能夠維護和優化既有系統。',
        icon: 'tabler:brand-php',
      },
      {
        title: '系統監控',
        description: '建置完整的監控體系，確保系統穩定性和效能。',
        icon: 'tabler:activity',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="讓我們一起創建卓越的技術解決方案"
    subtitle="如果您正在尋找經驗豐富的 Backend/DevOps 工程師，或想要討論技術議題，歡迎與我聯絡。"
    actions={[
      {
        variant: 'primary',
        text: '聯絡我',
        href: getPermalink('/contact'),
      },
      {
        text: '查看我的 GitHub',
        href: 'https://github.com/lisbethw1130',
      },
    ]}
  />
</Layout>
