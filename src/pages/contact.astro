---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: '聯絡我',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="聯絡我" title="讓我們保持聯繫！" />

  <!-- Features2 Widget ************** -->

  <Features2
    title="聯絡方式"
    items={[
      {
        title: '電子郵件',
        description: 'meow@liswu.me',
        icon: 'tabler:mail',
        callToAction: {
          text: '發送郵件',
          href: 'mailto:meow@liswu.me',
          variant: 'primary',
        },
      },
      {
        title: 'Facebook',
        description: 'Lisbeth Wu 吳宇萱',
        icon: 'tabler:brand-facebook',
        callToAction: {
          text: '造訪 Facebook',
          href: 'https://fb.me/LisbethW1130',
          target: '_blank',
          variant: 'primary',
        },
      },
    ]}
  />
</Layout>
