---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '我的部落格 — 分享技術與生活',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '查看文章',
        href: '/blog',
        icon: 'tabler:arrow-right',
      },
      { text: '關於我', href: '/about' },
    ]}
  >
    <Fragment slot="title">
      歡迎來到<span class="text-accent dark:text-white">我的部落格</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">分享技術心得、生活感悟與學習筆記</span>，記錄成長的點點滴滴。</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">我的部落格</span>
      在這裡，我會分享程式開發、技術學習、以及日常生活中的各種體驗與思考。
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note icon="tabler:tools" title="網站重建中" description="由於原本在點部落的部落格倒站，我決定重新建立這個新的部落格。這裡正在積極開發中，會將之前的文章逐步搬遷過來，並持續分享新的內容。感謝您的耐心等待與支持！" />

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="最新文章"
    information={`
      歡迎閱讀我的最新文章！這裡會定期更新各種技術分享、學習心得以及生活感悟。
      每一篇文章都是我用心撰寫的內容，希望能對你有所幫助。
    `}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '查看所有文章',
        href: '/blog',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">
      開始閱讀之旅
    </Fragment>

    <Fragment slot="subtitle">
      探索更多精彩內容，一起學習與成長！<br class="hidden md:inline" />
      期待與你分享更多有趣的想法和經驗。
    </Fragment>
  </CallToAction>
</Layout>